package thrustr:plugin@0.1.0;

interface types {
    variant error {
        /// The user's configuration is invalid, e.g. a path that doesn't exist.
        /// Deactivates the plugin until the user saves its configuration again.
        config(string),

        /// Credentials are missing, expired or rejected. Deactivates the plugin
        /// until the user logs in again.
        auth(string),

        /// Anything else, such as network failures or bugs. The plugin stays
        /// active.
        other(string),
    }

    variant field-value {
        text(string),
        %list(list<string>),
    }

    enum platform {
        windows,
        linux,
        macos,
    }

    record game {
        name: string,
        lookup-id: string,
        external-ids: map<string, string>,
        cover-url: option<string>,
        summary: option<string>,
        description: option<string>,
    }

    record game-version {
        id: string,
        pretty-name: option<string>,
        platform: platform,
    }

    record game-version-details {
        install-size: option<u64>,
        download-size: option<u64>,
    }
}
