package thrustr:plugin@0.1.0;

interface auth {
    use types.{error, field-value};

    record login-flow {
        url: string,
        target: string,
    }

    record login-callback {
        url: string,
        body: string,
    }

    record login-form {
        fields: map<string, field-value>,
    }

    variant login-request {
        flow(login-callback),
        form(login-form),
    }

    get-login-flow: async func() -> result<option<login-flow>, error>;
    login: async func(request: login-request) -> result<_, error>;
    logout: async func() -> result<_, error>;
}

world auth-capability {
    export auth;
}
