package thrustr:plugin@0.1.0;

interface config-store {
    use types.{error, field-value};

    get: func(field-id: string) -> result<field-value, error>;
}

interface config {
    use types.{error, field-value};

    record combobox-option {
        value: string,
        label: string,
    }

    validate: async func(fields: map<string, field-value>) -> result<_, error>;

    options: async func(field-id: string) -> result<list<combobox-option>, error>;
}

world config-capability {
    import config-store;

    export config;
}
